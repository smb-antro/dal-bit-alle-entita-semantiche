    :discussoInUnita :U24 .

:Firth a :Teorico ;
    rdfs:label "John Rupert Firth"@it ;
    rdfs:comment "Ipotesi distribuzionale: \"si conosce una parola dalla compagnia che tiene\" (1957)."@it ;
    :discussoInUnita :U33 .

:Wittgenstein a :Teorico ;
    rdfs:label "Ludwig Wittgenstein (tardo)"@it ;
    rdfs:comment "Significato come uso, giochi linguistici."@it ;
    :discussoInUnita :Gen31, :U33 .

:Bateson a :Teorico ;
    rdfs:label "Gregory Bateson"@it ;
    rdfs:comment "Sillogismo dell'erba; pleroma/creatura; schismogenesi."@it ;
    :discussoInUnita :U34, :U43, :U45 ;
    :citaOpera "Naven, 1936" .

:Varela a :Teorico ;
    rdfs:label "Francisco Varela"@it ;
    rdfs:comment "Autopoiesi e chiusura operazionale (con Maturana)."@it ;
    :discussoInUnita :U41 .

:Maturana a :Teorico ;
    rdfs:label "Humberto Maturana"@it ;
    rdfs:comment "Autopoiesi (con Varela)."@it ;
    :discussoInUnita :U41 .

:McCulloch a :Teorico ;
    rdfs:label "Warren McCulloch"@it ;
    rdfs:comment "Primo modello matematico del neurone (1943, con Pitts); neurofisiologo."@it ;
    :discussoInUnita :Gen33, :U41 .

:Pitts a :Teorico ;
    rdfs:label "Walter Pitts"@it ;
    rdfs:comment "Primo modello matematico del neurone (1943, con McCulloch); logico."@it ;
    :discussoInUnita :Gen33, :U41 .

:Hebb a :Teorico ;
    rdfs:label "Donald Hebb"@it ;
    rdfs:comment "Regola di rinforzo delle connessioni (1949), nella sua forma originale tecnica — non lo slogan con cui è oggi ricordato (vedi Shatz)."@it ;
    :discussoInUnita :Gen33, :U41 .

:Hubel a :Teorico ;
    rdfs:label "David Hubel"@it ;
    rdfs:comment "Organizzazione gerarchica della corteccia visiva (con Wiesel)."@it ;
    :discussoInUnita :Gen33 .

:Wiesel a :Teorico ;
    rdfs:label "Torsten Wiesel"@it ;
    rdfs:comment "Organizzazione gerarchica della corteccia visiva (con Hubel)."@it ;
    :discussoInUnita :Gen33 .

:Harnad a :Teorico ;
    rdfs:label "Stevan Harnad"@it ;
    rdfs:comment "Symbol grounding problem (1990)."@it ;
    :discussoInUnita :Gen23, :Gen31 .

:Pearl a :Teorico ;
    rdfs:label "Judea Pearl"@it ;
    rdfs:comment "Scala causale: associazione, intervento, controfattuale."@it ;
    :discussoInUnita :Gen23, :Gen32 .

:Hume a :Teorico ;
    rdfs:label "David Hume"@it ;
    rdfs:comment "La causalità come inferenza abituale, non percezione diretta."@it ;
    :discussoInUnita :Gen32 .

:Searle a :Teorico ;
    rdfs:label "John Searle"@it ;
    rdfs:comment "Esperimento mentale della stanza cinese (1980)."@it ;
    :discussoInUnita :Gen31 .

:Chalmers a :Teorico ;
    rdfs:label "David Chalmers"@it ;
    rdfs:comment "Problema facile / problema difficile della coscienza (1995)."@it ;
    :discussoInUnita :Gen34 .

:Tononi a :Teorico ;
    rdfs:label "Giulio Tononi"@it ;
    rdfs:comment "Integrated Information Theory (Φ)."@it ;
    :discussoInUnita :Gen34 .

:Baars a :Teorico ;
    rdfs:label "Bernard Baars"@it ;
    rdfs:comment "Global Workspace Theory."@it ;
    :discussoInUnita :Gen34 .

:Dehaene a :Teorico ;
    rdfs:label "Stanislas Dehaene"@it ;
    rdfs:comment "Sviluppo della Global Workspace Theory."@it ;
    :discussoInUnita :Gen34 .

:Kant a :Teorico ;
    rdfs:label "Immanuel Kant"@it ;
    rdfs:comment "Spazio come forma dell'intuizione."@it ;
    :discussoInUnita :Gen41 .

:MerleauPonty a :Teorico ;
    rdfs:label "Maurice Merleau-Ponty"@it ;
    rdfs:comment "Spazio vissuto attraverso il corpo."@it ;
    :discussoInUnita :Gen41 .

:Brooks a :Teorico ;
    rdfs:label "Rodney Brooks"@it ;
    rdfs:comment "Robotica embodied: l'intelligenza richiede corpi, non solo simboli."@it ;
    :discussoInUnita :Gen42 .

:Lakoff a :Teorico ;
    rdfs:label "George Lakoff"@it ;
    rdfs:comment "Metafore concettuali a origine sensomotoria (con Johnson)."@it ;
    :discussoInUnita :Gen42 .

:Johnson a :Teorico ;
    rdfs:label "Mark Johnson"@it ;
    rdfs:comment "Metafore concettuali a origine sensomotoria (con Lakoff)."@it ;
    :discussoInUnita :Gen42 .

:GalileoGalilei a :Teorico ;
    rdfs:label "Galileo Galilei"@it ;
    rdfs:comment "Qualità primarie/secondarie; fondazione della scienza quantificabile."@it ;
    :discussoInUnita :U32, :U54 .

:Wigner a :Teorico ;
    rdfs:label "Eugene Wigner"@it ;
    rdfs:comment "\"Irragionevole efficacia della matematica\"."@it ;
    :discussoInUnita :U34 .

:WeiEtAl2022 a :Teorico ;
    rdfs:label "Wei et al. (2022)"@it ;
    rdfs:comment "Conia il termine \"capacità emergenti\"."@it ;
    :discussoInUnita :Gen21, :U62 ;
    :citaOpera "TMLR, 2022, arXiv:2206.07682" .

:SchaefferEtAl2023 a :Teorico ;
    rdfs:label "Schaeffer, Miranda, Koyejo (2023)"@it ;
    rdfs:comment "Controargomento: l'emergenza può essere artefatto delle metriche."@it ;
    :discussoInUnita :Gen21, :U62 .

:HerculanoHouzel a :Teorico ;
    rdfs:label "Suzana Herculano-Houzel"@it ;
    rdfs:comment "Stima di ~86 miliardi di neuroni nel cervello umano (2009)."@it ;
    :discussoInUnita :U61 ;
    :citaOpera "Frontiers in Human Neuroscience, 2009" .

:BrownEtAl2020 a :Teorico ;
    rdfs:label "Brown et al. (2020)"@it ;
    rdfs:comment "Paper GPT-3, citato per gli ordini di grandezza dei parametri."@it ;
    :discussoInUnita :U61 .

:ChowdheryEtAl2022 a :Teorico ;
    rdfs:label "Chowdhery et al. (2022)"@it ;
    rdfs:comment "Paper PaLM (Google), citato per gli ordini di grandezza."@it ;
    :discussoInUnita :U61 .

:OuyangEtAl2022 a :Teorico ;
    rdfs:label "Ouyang et al. (2022)"@it ;
    rdfs:comment "Introduce il fine-tuning verso il comportamento istruito."@it ;
    :discussoInUnita :U64 ;
    :citaOpera "InstructGPT, 2022" .

:Bacon a :Teorico ;
    rdfs:label "Francis Bacon"@it ;
    rdfs:comment "\"Veritas filia temporis\" — la verità è figlia del tempo."@it ;
    :discussoInUnita :U63 ;
    :citaOpera "Veritas filia temporis" .

:Bayle a :Teorico ;
    rdfs:label "Pierre Bayle"@it ;
    rdfs:comment "Contro-tesi \"error filius temporis\"."@it ;
    :discussoInUnita :U63 ;
    :citaOpera "Error filius temporis" .

:Lawvere a :Teorico ;
    rdfs:label "William Lawvere"@it ;
    rdfs:comment "Geometria differenziale sintetica: il continuo come primitivo."@it ;
    :discussoInUnita :U66 .

:Peirce a :Teorico ;
    rdfs:label "Charles Sanders Peirce"@it ;
    rdfs:comment "Abbozza una versione della tavola di verità già tra il 1883 e il 1902, in manoscritti rimasti inediti per decenni."@it ;
    :discussoInUnita :Fondamenti1 .

:Post a :Teorico ;
    rdfs:label "Emil Post"@it ;
    rdfs:comment "Usa la tavola di verità (1921, indipendentemente da Wittgenstein) per dimostrare che E, O e NON bastano a costruire qualsiasi funzione booleana."@it ;
    :discussoInUnita :Fondamenti1 .

:Shatz a :Teorico ;
    rdfs:label "Carla Shatz"@it ;
    rdfs:comment "Conia decenni dopo lo slogan «neurons that fire together, wire together», spesso attribuito per errore direttamente a Hebb (1949) — nessuna data/opera specifica data dal testo."@it ;
    :discussoInUnita :Gen33 .

########################################################################
# Dataset
########################################################################

:VocabolarioBpeDelSaggio a :Dataset ;
    rdfs:label "Vocabolario BPE del saggio"@it ;
    rdfs:comment "334 simboli (34 caratteri base + 300 unioni apprese), addestrato realmente sul testo di Genealogia."@it ;
    :haStatoEpistemico :Reale ;
    :dataVerifica "2026-07-06"^^xsd:date .

:Corpus46FrasiItaliane a :Dataset ;
    rdfs:label "Corpus di 46 frasi italiane"@it ;
    rdfs:comment "Corpus scritto apposta per il predittore n-grammi (34 training, 12 test)."@it ;
    :haStatoEpistemico :Reale ;
    :dataVerifica "2026-07-06"^^xsd:date .

:DatiCalibrazioneReliability a :Dataset ;
    rdfs:label "Dati di calibrazione (reliability diagram)"@it ;
    rdfs:comment "65 previsioni reali raggruppate in 3 bucket di confidenza, misurate sul corpus di 46 frasi."@it ;
    :haStatoEpistemico :Reale ;
    :dataVerifica "2026-07-06"^^xsd:date .

:EmbeddingFastTextIt23Parole a :Dataset ;
    rdfs:label "Embedding fastText di 23 parole italiane"@it ;
    rdfs:comment "Vettori reali a 300 dimensioni, proiettati in 2D per esplorazione, aritmetica e polisemia."@it ;
    :haStatoEpistemico :Reale ;
    :dataVerifica "2026-07-06"^^xsd:date .

:DiagonaleCantorInterattiva a :Dataset ;
    rdfs:label "Diagonale di Cantor interattiva"@it ;
    rdfs:comment "Griglia di cifre con costruzione del numero che sfugge a qualunque lista."@it ;
    :haStatoEpistemico :Reale ;
    :dataVerifica "2026-07-06"^^xsd:date .

:ReteXorAddestrata a :Dataset ;
    rdfs:label "Rete XOR addestrata realmente"@it ;
    rdfs:comment "Multi-layer perceptron addestrato via backpropagation, 4/4 corretto, confine di decisione curvo."@it ;
    :haStatoEpistemico :Reale ;
    :dataVerifica "2026-07-06"^^xsd:date .

:PaesaggioPerditaDueMinimi a :Dataset ;
    rdfs:label "Paesaggio di perdita a due minimi"@it ;
    rdfs:comment "Superficie di loss (due gaussiane invertite) con minimo globale e locale; discesa del gradiente verificata numericamente. Costruita (non misurata da un modello reale), ma verificata: \"reale\" qui significa verificato algoritmicamente, non proveniente da un training di produzione — nota esplicita per non confondere le due cose."@it ;
    :haStatoEpistemico :Reale ;
    :dataVerifica "2026-07-06"^^xsd:date .

:EsempiNeuroneSingolo a :Dataset ;
    rdfs:label "Esempi di neurone singolo"@it ;
    rdfs:comment "Pesi/ingressi regolabili a slider, variante continua del calcolatore booleano. Nessun addestramento o verifica: calcolatore dal vivo."@it ;
    :haStatoEpistemico :Illustrativo .

:DatiAttentionIllustrativi a :Dataset ;
    rdfs:label "Dati di attention illustrativi"@it ;
    rdfs:comment "Pesi scritti a mano per chiarezza pedagogica — esplicitamente non output di un vero Transformer."@it ;
    :haStatoEpistemico :Illustrativo .

:ConfrontoBaseFineTuned a :Dataset ;
    rdfs:label "Confronto modello di base / fine-tuned"@it ;
    rdfs:comment "Prompt/risposta scritti per illustrare l'effetto di fine-tuning e RLHF, non output di un modello reale."@it ;
    :haStatoEpistemico :Illustrativo .

:CurvaCapacitaEmergentiIllustrativa a :Dataset ;
    rdfs:label "Curva illustrativa delle capacità emergenti"@it ;
    rdfs:comment "Andamento piatto-poi-salto per un compito tipo, dichiarato esplicitamente non misurato da un paper specifico."@it ;
    :haStatoEpistemico :Illustrativo .

:SliderScalaLogaritmica a :Dataset ;
    rdfs:label "Slider di scala logaritmica"@it ;
    rdfs:comment "Confronto parametri/dati (GPT-3, PaLM) con il cervello umano, su numeri reali verificati."@it ;
    :haStatoEpistemico :Reale ;
    :dataVerifica "2026-07-06"^^xsd:date .

:TimelineAlfabetoCorporaLlm a :Dataset ;
    rdfs:label "Timeline storica alfabeto→corpora LLM"@it ;
    rdfs:comment "Alfabeto, von Neumann 1958, digitalizzazione di massa, corpora di addestramento — date verificate."@it ;
    :haStatoEpistemico :Reale ;
    :dataVerifica "2026-07-06"^^xsd:date .

:LivelliQuantizzazione a :Dataset ;
    rdfs:label "Livelli di quantizzazione"@it ;
    rdfs:comment "FP32→FP16/BF16→INT8→INT4, con riferimento a strumenti reali (llama.cpp)."@it ;
    :haStatoEpistemico :Reale ;
    :dataVerifica "2026-07-06"^^xsd:date .

:ConfrontoRasterSvg a :Dataset ;
    rdfs:label "Confronto raster/SVG"@it ;
    rdfs:comment "Cerchio raster 24×24px generato via Pillow e suo equivalente SVG, stessi colori del design system."@it ;
    :haStatoEpistemico :Reale ;
    :dataVerifica "2026-07-06"^^xsd:date .

:CalcolatoreBooleanoInterattivo a :Dataset ;
    rdfs:label "Calcolatore booleano interattivo"@it ;
    rdfs:comment "Interruttori A/B che mostrano dal vivo E, O, NON, XOR e F = (A∧B)∨¬A."@it ;
    :haStatoEpistemico :Reale .

