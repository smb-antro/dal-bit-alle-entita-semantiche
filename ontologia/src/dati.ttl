########################################################################
# Teorici
########################################################################

:Leibniz a :Teorico ;
    rdfs:label "Gottfried Leibniz"@it ;
    rdfs:comment "Characteristica Universalis, il sogno del pensiero come calcolo; anche calcolo infinitesimale (con Newton)."@it ;
    :discussoInUnita :Gen11, :U32 .

:Newton a :Teorico ;
    rdfs:label "Isaac Newton"@it ;
    rdfs:comment "Calcolo infinitesimale (con Leibniz); spazio come contenitore assoluto."@it ;
    :discussoInUnita :U32, :Gen41 .

:Boole a :Teorico ;
    rdfs:label "George Boole"@it ;
    rdfs:comment "Algebra della logica; origine degli operatori E/O/NON."@it ;
    :discussoInUnita :Gen11, :Fondamenti1 ;
    :citaOpera "The Laws of Thought, 1854" .

:Frege a :Teorico ;
    rdfs:label "Gottlob Frege"@it ;
    rdfs:comment "Riduzione dell'aritmetica alla logica; distinzione senso/riferimento."@it ;
    :discussoInUnita :Gen11, :Gen31 .

:Russell a :Teorico ;
    rdfs:label "Bertrand Russell"@it ;
    rdfs:comment "Paradosso che incrina i Grundgesetze di Frege; Principia Mathematica con Whitehead."@it ;
    :discussoInUnita :Gen11 ;
    :citaOpera "Principia Mathematica (con Alfred North Whitehead)" .

:Whitehead a :Teorico ;
    rdfs:label "Alfred North Whitehead"@it ;
    rdfs:comment "Co-autore di Principia Mathematica."@it ;
    :discussoInUnita :Gen11 ;
    :citaOpera "Principia Mathematica (con Bertrand Russell)" .

:Godel a :Teorico ;
    rdfs:label "Kurt Gödel"@it ;
    rdfs:comment "Teoremi di incompletezza (1931); aritmetizzazione."@it ;
    :discussoInUnita :Gen12, :U15 .

:Turing a :Teorico ;
    rdfs:label "Alan Turing"@it ;
    rdfs:comment "Macchina universale; Test di Turing; risponde all'obiezione gödeliana."@it ;
    :discussoInUnita :Gen12 .

:Lucas a :Teorico ;
    rdfs:label "J.R. Lucas"@it ;
    rdfs:comment "Riformula l'obiezione gödeliana contro il meccanicismo (1961)."@it ;
    :discussoInUnita :Gen12 .

:Penrose a :Teorico ;
    rdfs:label "Roger Penrose"@it ;
    rdfs:comment "Riprende l'argomento di Lucas, collegandolo alla coscienza."@it ;
    :discussoInUnita :Gen12 .

:McCarthy a :Teorico ;
    rdfs:label "John McCarthy"@it ;
    rdfs:comment "Conia \"intelligenza artificiale\"; proposta di Dartmouth (1956)."@it ;
    :discussoInUnita :Gen13 .

:Minsky a :Teorico ;
    rdfs:label "Marvin Minsky"@it ;
    rdfs:comment "Dartmouth; Perceptrons (con Papert, 1969) — dimostra il limite di XOR."@it ;
    :discussoInUnita :Gen13 ;
    :citaOpera "Perceptrons, 1969 (con Seymour Papert)" .

:Shannon a :Teorico ;
    rdfs:label "Claude Shannon"@it ;
    rdfs:comment "Co-firmatario della proposta di Dartmouth."@it ;
    :discussoInUnita :Gen13 .

:Rochester a :Teorico ;
    rdfs:label "Nathaniel Rochester"@it ;
    rdfs:comment "Co-firmatario della proposta di Dartmouth."@it ;
    :discussoInUnita :Gen13 .

:Rosenblatt a :Teorico ;
    rdfs:label "Frank Rosenblatt"@it ;
    rdfs:comment "Costruisce il Perceptron (1958)."@it ;
    :discussoInUnita :Gen13, :U42 .

:Papert a :Teorico ;
    rdfs:label "Seymour Papert"@it ;
    rdfs:comment "Perceptrons con Minsky (1969)."@it ;
    :discussoInUnita :Gen13 ;
    :citaOpera "Perceptrons, 1969 (con Marvin Minsky)" .

:Rumelhart a :Teorico ;
    rdfs:label "David Rumelhart"@it ;
    rdfs:comment "Articolo del 1986 sul backpropagation (con Hinton e Williams)."@it ;
    :discussoInUnita :Gen15 .

:Hinton a :Teorico ;
    rdfs:label "Geoffrey Hinton"@it ;
    rdfs:comment "Backpropagation (1986); deep learning (2006, con Osindero e Teh)."@it ;
    :discussoInUnita :Gen15 .

:Williams a :Teorico ;
    rdfs:label "Ronald Williams"@it ;
    rdfs:comment "Articolo del 1986 sul backpropagation."@it ;
    :discussoInUnita :Gen15 .

:Osindero a :Teorico ;
    rdfs:label "Simon Osindero"@it ;
    rdfs:comment "Co-autore con Hinton del metodo 2006 per reti profonde."@it ;
    :discussoInUnita :Gen15 .

:Teh a :Teorico ;
    rdfs:label "Yee-Whye Teh"@it ;
    rdfs:comment "Co-autore con Hinton del metodo 2006 per reti profonde."@it ;
    :discussoInUnita :Gen15 .

:Mikolov a :Teorico ;
    rdfs:label "Tomas Mikolov"@it ;
    rdfs:comment "Guida il gruppo che pubblica Word2Vec (2013)."@it ;
    :discussoInUnita :Gen15, :U33 .

:Bahdanau a :Teorico ;
    rdfs:label "Dzmitry Bahdanau"@it ;
    rdfs:comment "Introduce il meccanismo di attention nella traduzione automatica (2014-2015)."@it ;
    :discussoInUnita :Gen16 .

:VonNeumann a :Teorico ;
    rdfs:label "John von Neumann"@it ;
    rdfs:comment "The Computer and the Brain (1958); momento di consapevolezza della discretizzazione."@it ;
    :discussoInUnita :U11, :U63, :U42 ;
    :citaOpera "The Computer and the Brain, 1958" .

:Cantor a :Teorico ;
    rdfs:label "Georg Cantor"@it ;
    rdfs:comment "Argomento diagonale: i numeri reali non sono numerabili."@it ;
    :discussoInUnita :U15, :U31 .

:Vapnik a :Teorico ;
    rdfs:label "Vladimir Vapnik"@it ;
    rdfs:comment "Formalizza le Support Vector Machines."@it ;
    :discussoInUnita :Gen14 .

:Chomsky a :Teorico ;
    rdfs:label "Noam Chomsky"@it ;
